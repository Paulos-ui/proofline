# ---------------------------------------------------------------------------
# Proofline environment
#
# Copy to .env.local and fill in what you need. Nothing here is required to run
# the demonstration case or file verification — both work with an empty file.
# ---------------------------------------------------------------------------

# Public base URL. Used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — needed for accounts, real cases and evidence storage.
# Without these, /dashboard explains that the deployment is demo-only.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, sb_publishable_... (older projects: the anon key).
# Safe to expose to the browser — row level security is what protects the data,
# not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, sb_secret_... (older projects: the service_role key).
# SERVER ONLY. It bypasses row level security entirely, so it must never appear
# in a NEXT_PUBLIC_ variable or reach the browser. Supabase automatically revokes
# secret keys it finds in public GitHub repositories.
# Proofline uses the request-scoped user client for normal work and only reaches
# for this where a server task genuinely cannot run as the user.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analysis — needed to process real uploads.
# Uploading and fingerprinting work without it; extraction does not.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# The model used for vision and PDF extraction. Set in one place only.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ceiling on the structured response. Raise it for very dense artifacts.
ANTHROPIC_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Transcription — needed for audio artifacts.
# If this is unset, audio uploads are marked failed with a clear reason rather
# than being treated as analysed.
# ---------------------------------------------------------------------------

# Any name you like; its presence is what enables the adapter.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Any OpenAI-compatible /audio/transcriptions endpoint.
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Public integrity anchor — entirely optional.
#
# When enabled, Proofline publishes ONE memo per anchored case containing the
# string "proofline:v1:" followed by the case's Merkle root. Nothing else is
# ever written on chain: no names, filenames, descriptions or case metadata.
#
# CUSTODY: the key below signs and pays for those transactions. Whoever runs
# this deployment holds it, which is why no user needs a wallet. Treat it as a
# low-value operational key on devnet. It is read server-side only and is never
# exposed to the browser.
# ---------------------------------------------------------------------------

ENABLE_SOLANA_ANCHOR=false
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Either a base58 secret key or a JSON byte array from `solana-keygen`.
SOLANA_ANCHOR_PRIVATE_KEY=
